<ContentDialog x:Class="Typedown.Uno.Views.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Typedown.Uno.Views"
               DefaultButton="Close"
               MinWidth="900" MaxWidth="1080">
  <!-- WinUI caps dialogs at ~548px; the two-column layout needs more. -->
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
  </ContentDialog.Resources>
  <!-- Categories on the left, rows built in code so every label goes through the localization table. -->
  <Grid Width="840" Height="520" ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ListView x:Name="Categories" SelectionChanged="OnCategoryChanged" SelectionMode="Single"/>
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
      <StackPanel x:Name="Container" Spacing="2" Padding="0,0,14,0"/>
    </ScrollViewer>
  </Grid>
</ContentDialog>
