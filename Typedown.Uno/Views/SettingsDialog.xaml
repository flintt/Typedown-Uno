<ContentDialog x:Class="Typedown.Uno.Views.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Typedown.Uno.Views"
               DefaultButton="Close">
  <!-- The rows are built in code so every label goes through the localization table. -->
  <ScrollViewer MaxHeight="560" MinWidth="460">
    <StackPanel x:Name="Container" Spacing="2" Padding="0,0,14,0"/>
  </ScrollViewer>
</ContentDialog>
