<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Typedown.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>uk.mingdan.typedown</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Typedown.Uno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Typedown.Uno powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      WebView;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the original Typedown logo instead of the template's placeholder. -->
    <UnoIcon Remove="Assets/Icons/icon.svg" />
    <UnoIcon Include="Assets/Icons/icon.png" ForegroundFile="Assets/Icons/icon_foreground.png" Color="#F3F3F3" ForegroundScale="0.7" />
    <!-- Shipped as a plain file too: the Linux desktop entry and the installer need a real PNG. -->
    <Content Include="Assets/Icons/icon.png" Link="Assets/typedown.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
